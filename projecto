c2.metric("IGPR promedio proyectado", "—" if pd.isna(avg) else f"{avg:.1f}")
c3.metric("Meta > 70", "CUMPLE" if pd.notna(avg) and avg>70 else "NO CUMPLE")

# Mínimo necesario si se quiere llegar a 70, suponiendo que los proyectos nuevos
# tienen IGPR de 100. También permite saber cuántos proyectos de 100 hacen falta.
existing_scores = included["IGPR PROYECTADO"].tolist()
s = sum(existing_scores)
n = len(existing_scores)
if n:
    if avg > 70:
        needed = 0
    else:
        needed = int(np.floor((70*n - s)/(100-70))+1)
        needed=max(0,needed)
    st.info(f"Si los proyectos nuevos obtuvieran 100 puntos, se necesitarían aproximadamente {needed} proyectos adicionales para superar 70, manteniendo los proyectos incluidos actuales.")

# Tabla final
st.subheader("4. Resultado por proyecto")
show_cols=[c for c in ["BPIN","NOMBRE","ESTADO","Nuevo estado","IGPR_ACTUAL","IGPR PROYECTADO","Tipo cálculo","No medir","Observación"] if c in edited.columns]
st.dataframe(edited[show_cols], use_container_width=True, hide_index=True)

