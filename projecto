def num(x, default=np.nan):
    if pd.isna(x):
        return default
    try:
        return float(str(x).replace(",", "").replace("%", "").strip())
    except Exception:
        return default

def dateval(x):
    if pd.isna(x) or x == "":
        return pd.NaT
    return pd.to_datetime(x, errors="coerce")

def safe_avg(values):
    v = [x for x in values if pd.notna(x)]
    return float(np.mean(v)) if v else np.nan

def contracting_score(days, scenario):
    """Reglas documentadas para Sin contratar."""
    if pd.isna(days):
        return np.nan
    d = float(days)
    if scenario == 1:
        if d <= 45:
            return 100.0
        if d > 60:
            return 0.0
        # 46-60: interpolación lineal 100 -> 0
        return max(0.0, min(100.0, (60-d)/(60-45)*100))
    if scenario == 2:
        # El PDF indica 100 <= 6 meses y 0 >= 6 meses.
        # Se modela como lineal en días entre 0 y 6 meses (180 días)
        return max(0.0, min(100.0, (180-d)/180*100))
    if scenario == 3:
        # El PDF contiene una inconsistencia tipográfica en una viñeta
        # (120 días y una referencia posterior a 60). Se usa el umbral
        # principal explícito: <=120 = 100; >180 = 0; 120-180 lineal.
        if d <= 120:
            return 100.0
        if d > 180:
            return 0.0
        return max(0.0, min(100.0, (180-d)/(180-120)*100))
    return np.nan

def breach_score(fin, fis):
    """Indicador brecha: 100 si está dentro de la tolerancia, 0 si la supera."""
    fin = num(fin); fis = num(fis)
    if pd.isna(fin) or pd.isna(fis):
        return np.nan
    # La metodología usa avance financiero y brecha en puntos porcentuales.
    gap = abs(fin-fis)
    if fin < 60:
        allowed = 50
    elif fin < 70:
        allowed = 40
    elif fin < 80:
        allowed = 30
    elif fin < 90:
        allowed = 20
    else:
        allowed = 10
    return 100.0 if gap <= allowed else 0.0

def project_score_execution(row, cutoff, phys=None, fin=None, spi=None, cpi=None,
                            programming_status=None, reprogram_factor=None):
    """
    Escenario 1 de En ejecución: 40% cronograma + 20% costo + 40% brecha.
    Escenario 2 (sin avance físico/financiero): 100% cronograma.
    El descuento de programación vencida se aplica al resultado final,
    de acuerdo con la metodología.
    """
    phys = num(row.get("AVANCE_FÍSICO"), np.nan) if phys is None else float(phys)
    fin = num(row.get("AVANCE_FINANCIERO"), np.nan) if fin is None else float(fin)
    spi = num(row.get("SPI"), np.nan) if spi is None else float(spi)
    cpi = num(row.get("CPI"), np.nan) if cpi is None else float(cpi)

    # En la base, el indicador de cronograma ya viene calculado como 40/100.
    # Para simulación, si el usuario entrega SPI, se transforma de forma
    # configurable y conservadora: SPI>=1 -> 100; SPI<1 -> SPI*100.
    if pd.notna(spi):
        cron = 100.0 if spi >= 1 else max(0, min(100, spi*100))
    else:
        cron = num(row.get("CALIFICACIÓN_CRONOGRAMA"), np.nan)

    if pd.notna(cpi):
        costo = 100.0 if cpi >= 1 else 0.0
    else:
        costo = num(row.get("CALIFICACIÓN_COSTO"), np.nan)

    brecha = breach_score(fin, phys)

    moved = (phys > num(row.get("AVANCE_FÍSICO_BASE"), phys) if pd.notna(num(row.get("AVANCE_FÍSICO_BASE"), np.nan)) else False)
    # Para la proyección manual se considera avance si alguno de los dos
    # porcentajes es mayor que cero.
    has_progress = (pd.notna(phys) and phys > 0) or (pd.notna(fin) and fin > 0)

    if not has_progress:
        raw = cron if pd.notna(cron) else np.nan
    else:
        parts = []
        if pd.notna(cron): parts.append(0.40*cron)
        if pd.notna(costo): parts.append(0.20*costo)
        if pd.notna(brecha): parts.append(0.40*brecha)
        raw = sum(parts) if parts else np.nan

    factor = 1.0
    if programming_status == "Programación vencida":
        factor *= 0.50
    elif programming_status == "Sin programación":
        raw = 0.0

    if reprogram_factor is not None and pd.notna(reprogram_factor):
        factor *= float(reprogram_factor)

    return raw * factor if pd.notna(raw) else np.nan

def final_factor(row):
    # Reprogramaciones: la base suministrada trae directamente el % afectación.
    f = num(row.get("% AFECTACIÓN REPROGRAMACIÓN"), 1.0)
    if pd.isna(f):
        f = 1.0
    return f

