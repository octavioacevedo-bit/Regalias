# -----------------------------
# Cálculo de proyección
# -----------------------------
def calc_row(r):
    if bool(r["No medir"]):
        return np.nan, "NO MEDIR"
    manual = num(r["IGPR manual"])
    if pd.notna(manual):
        return max(0,min(100,manual)), "MANUAL"

    state = str(r["Nuevo estado"]).upper()
    phys = num(r["Físico proyectado (%)"])
    fin = num(r["Financiero proyectado (%)"])
    spi = num(r["SPI proyectado"])
    cpi = num(r["CPI proyectado"])
    prog = r["Programación"]

    if state == "EN EJECUCIÓN":
        # Si no se entrega SPI/CPI, usa las calificaciones actuales cuando existan.
        rr = r.copy()
        score = project_score_execution(
            rr, cutoff, phys=phys, fin=fin, spi=spi, cpi=cpi,
            programming_status=prog
        )
        if pd.isna(score):
            # respaldo: si existe IGPR actual, mantenerlo como baseline
            score = num(r["IGPR_ACTUAL"])
        return score, "MODELO EN EJECUCIÓN"

    if state == "TERMINADO":
        # El dato más fiable para terminado debe venir de los indicadores de producto.
        # Si no están disponibles, no se inventa: se conserva baseline.
        base = num(r["IGPR_ACTUAL"])
        return base, "BASE — ingresar % indicadores producto para mayor precisión"

    if state == "SIN CONTRATAR":
        # La metodología actual exige 2 indicadores de 50%.
        # La eficiencia de programación no está suficientemente estructurada
        # en la base suministrada; por seguridad se deja parametrizable.
        return num(r["IGPR_ACTUAL"]), "BASE — falta parametrizar programación"

    return num(r["IGPR_ACTUAL"]), "BASE"

scores = []
notes = []
for _, r in edited.iterrows():
    s,n = calc_row(r)
    scores.append(s); notes.append(n)

edited["IGPR PROYECTADO"] = scores
edited["Tipo cálculo"] = notes

