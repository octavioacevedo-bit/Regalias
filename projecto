df = df.loc[:, ~pd.Index(df.columns).duplicated()]
df = df.dropna(how="all").copy()

# Normalización de nombres usados por el motor
rename = {}
for c in df.columns:
    s = str(c).upper()
    if s == "BPIN": rename[c] = "BPIN"
    elif "NOMBRE DEL PROYECTO" in s: rename[c] = "NOMBRE"
    elif "ESTADO GENERAL" in s: rename[c] = "ESTADO"
    elif s.startswith("FECHA INICIAL DE LA PROGRAMACIÓN"): rename[c] = "FECHA_INI_PROG"
    elif s.startswith("FECHA FINAL DE LA PROGRAMACIÓN"): rename[c] = "FECHA_FIN_PROG"
    elif "AVANCE FÍSICO" in s: rename[c] = "AVANCE_FÍSICO"
    elif "AVANCE FINANCIERO" in s: rename[c] = "AVANCE_FINANCIERO"
    elif "DESEMPEÑO DEL CRONOGRAMA" in s and "CALIFICACIÓN" in s: rename[c] = "CALIFICACIÓN_CRONOGRAMA"
    elif "DESEMPEÑO DEL COSTO" in s and "CALIFICACIÓN" in s: rename[c] = "CALIFICACIÓN_COSTO"
    elif s.strip() == "CPI": rename[c] = "CPI"
    elif "SPI(T)" in s: rename[c] = "SPI"
    elif "IGPR PROYECTO" in s and "FINAL" in s: rename[c] = "IGPR_ACTUAL"
    elif "% AFECTACION REPROGRAMACIÓN" in s or "% AFECTACION REPROGRAMACIÓN" == s.strip(): rename[c] = "% AFECTACIÓN REPROGRAMACIÓN"
df = df.rename(columns=rename)

# Cualquier columna duplicada queda fuera
for needed in ["BPIN","NOMBRE","ESTADO","AVANCE_FÍSICO","AVANCE_FINANCIERO","IGPR_ACTUAL"]:
